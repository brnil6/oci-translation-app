FROM python:3.11-slim

WORKDIR /app

COPY option_b_fastapi/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY core/ /app/core/
COPY option_b_fastapi/ /app/option_b_fastapi/

# OCI API key auth generated at runtime by the container entrypoint
RUN chmod 755 /app/option_b_fastapi/docker-entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/app/option_b_fastapi/docker-entrypoint.sh"]
